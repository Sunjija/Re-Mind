  "narrative": {
    "northStar": "접힌 마음 지도",
    "overview": "Re:Mind의 화면은 상담 채팅창이 아니라, 사용자가 자기 말을 한 장씩 펼쳐보는 조용한 작업대다. 따뜻한 종이색 위에 짙은 녹색 잉크를 놓고 산호색은 진행과 선택을 확인하는 작은 표시로만 사용한다.",
    "keyCharacteristics": ["따뜻한 종이 바탕과 차분한 녹색 잉크", "한 번에 한 질문만 펼쳐지는 낮은 인지 부하", "사람의 말이 중심인 비채팅형 구조", "결정권과 안전을 분명히 남기는 인터랙션", "AI 개입과 기본 질문 전환을 숨기지 않는 투명성", "모바일에서 세 줄 안에 읽히는 짧은 AI 질문", "AI의 이해를 사용자가 수정하고 깊이를 직접 고르는 적응형 흐름"],
    "rules": [
      { "name": "Quiet Accent", "body": "산호색은 한 화면의 작은 신호에만 사용한다.", "section": "colors" },
      { "name": "Human Sentence", "body": "제목은 사용자가 스스로 답할 수 있는 질문 또는 선택권을 남기는 문장이어야 한다.", "section": "typography" },
      { "name": "Flat by Default", "body": "깊이는 구조가 바뀌는 표면에만 허용한다.", "section": "elevation" }
    ],
    "dos": ["Do 한 화면에 하나의 질문과 하나의 주요 행동만 둔다.", "Do 안전 안내와 종료 경로를 어느 단계에서도 찾을 수 있게 한다."],
    "donts": ["Don't 상담사 아바타, 채팅 말풍선, AI 반짝이 아이콘으로 화면을 꾸미지 않는다.", "Don't 사용자가 말하지 않은 감정·의도·진단을 결과에 추가하지 않는다."]
