{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "re-mind-reflection-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "ANTHROPIC_MODEL": "claude-haiku-4-5",
    "ALLOWED_ORIGINS": "https://sunjija.github.io,http://127.0.0.1:4173,http://localhost:4173"
  },
  "ratelimits": [
    {
      "name": "SESSION_RATE_LIMITER",
      "namespace_id": "202608101",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "202608102",
      "simple": { "limit": 180, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
